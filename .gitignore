node_modules/
dist/
build/
.cache/
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python & Backend virtual environments
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# IDE and Operating System
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs
*.log
logs/

# Local Scratch / Clones
scratch/
JalDristi 2.0/
.system_generated/
